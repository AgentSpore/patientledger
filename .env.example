# Persistence — local SQLite file is the source of truth
DATABASE_URL=patientledger.db

# HTTP
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Import adapters (true/false)
ENABLE_FLAREDOWN_CSV=true
ENABLE_BEARABLE_JSON=true
ENABLE_MYSYMPTOMS_CSV=true
ENABLE_APPLE_HEALTH_XML=true
ENABLE_FHIR_BUNDLE=true
ENABLE_FITBIT_CSV=true

# Export targets (true/false)
ENABLE_EXPORT_FHIR_BUNDLE=true
ENABLE_EXPORT_CLINICAL_PDF=true
ENABLE_EXPORT_GENERIC_CSV=true

# Dedup
DEDUP_WINDOW_MINUTES=30

# Trust levels
DEFAULT_TRUST_PATIENT=patient-asserted
DEFAULT_TRUST_DEVICE=device-measured
